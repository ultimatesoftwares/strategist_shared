<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- IVenueHistorySource / Bar / Tick / DateRange (the history-source
         port the QuestDB store drives). -->
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parquet decode for exports (format=parquet). CSV is parsed by hand.
         5.x is the last line with the untyped DataColumn reader (6.x went
         span-generic); Snappier is pinned past its 1.1.6 advisory
         (GHSA-pggp-6c3x-2xmx). -->
    <PackageReference Include="Parquet.Net" Version="5.6.1" />
    <PackageReference Include="Snappier" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MarketData.Lse.Tests" />
  </ItemGroup>

</Project>
