<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Strategist.FleetMember</RootNamespace>
    <AssemblyName>Strategist.FleetMember</AssemblyName>
    <Description>The member side of the fleet control plane: FleetMemberOptions (identity, capabilities, the advertised control URL and the server's base URL) and FleetControlDialerService (the reverse-dial gRPC command stream — the member dials the server, beats its liveness/load/RTT, and answers HTTP-shaped commands against its own local control listener, so a fleet host needs zero inbound ports). Data planes ride RabbitMQ.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <!-- FleetControl reverse-dial stream (client side). -->
    <PackageReference Include="Google.Protobuf" Version="3.33.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Client stubs only; the Server compiles the service side. -->
    <Protobuf Include="..\Protos\fleet_control.proto" GrpcServices="Client" Link="Protos\fleet_control.proto" />
  </ItemGroup>

</Project>
