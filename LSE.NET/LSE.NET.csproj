<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LSE.NET</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.2</VersionSuffix>
    <Description>HTTP historical market data and live WebSockets for London Strategic Edge Data 3.0.</Description>
    <PackageTags>market-data;websocket;london-strategic-edge</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**;examples/**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parquet decode for exports (format=parquet). CSV is parsed by hand.
         5.x is the last line with the untyped DataColumn reader (6.x went
         span-generic); Snappier is pinned past its 1.1.6 advisory
         (GHSA-pggp-6c3x-2xmx). -->
    <PackageReference Include="Parquet.Net" Version="5.6.1" />
    <PackageReference Include="Snappier" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LSE.NET.Tests" />
  </ItemGroup>

</Project>
