<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Server.Data</RootNamespace>
    <AssemblyName>Repository.Persistence</AssemblyName>
    <Description>Relational persistence of the shared Strategist schema: the server's AppDbContext (Identity + trading entities, Server.Data/Server.Models namespaces). Namespaces are frozen until the M9 rename.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Design-time only (PrivateAssets): lets the EF CLI use this project
         as its own startup project, e.g.
         `dotnet ef migrations add X (project: shared/Persistence)`. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
