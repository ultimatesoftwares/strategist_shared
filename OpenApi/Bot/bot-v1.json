{
  "openapi": "3.1.2",
  "info": {
    "title": "strategist_bot control API",
    "description": "REST control surface of the single-process trading engine: account/position/order inspection and control, risk kill switch, and MT4/MT5 terminal fleet management (subscriptions, ping, batch close).",
    "version": "v1"
  },
  "paths": {
    "/api/accounts": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "List all configured accounts with supervision state and engine stats.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get one account's supervision state and engine stats.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}/positions": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Current position, top-of-book, and market session per symbol.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}/orders": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Order history for the account; pass open=true for working orders only.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "open",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}/book": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Live aggregated L2 order book for one symbol: best-first levels per\nside (prices humanized via the adapter's scale), spread, and the\nbook's last update time.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}/positions/close": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Flatten the position in a symbol with a marketable limit order at the touch.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}/positions/modify": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Work the position in a symbol toward the requested target lots.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModifyPositionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ModifyPositionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ModifyPositionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}/positions/sync": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Reconcile engine positions against the broker's open-position snapshot\n(clears phantom positions from lost fills or broker-side closes).\nAlso runs automatically at connect and every venues.positionSyncSeconds.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}/orders/{orderId}/cancel": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Cancel one working order by engine order id.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "uint64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}/orders/cancel-all": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Cancel every working order on the account.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}/risk/kill": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Trip the risk kill switch: all new orders are blocked until reset.\n    Journaled: the trip survives account reconnects and bot restarts.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/KillSwitchRequest"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/KillSwitchRequest"
                  }
                ]
              }
            },
            "application/*+json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/KillSwitchRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/accounts/{name}/risk/reset": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Reset the risk kill switch and resume trading.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/instruments/catalog/sync": {
      "post": {
        "tags": [
          "Instruments"
        ],
        "summary": "Manually resync one running venue's catalog (?account=NAME,\n    a broker account name or a connected terminal id), or every running\n    account and connected terminal when the parameter is omitted.",
        "parameters": [
          {
            "name": "account",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Configured defaults, journaled overrides, and the effective result.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Edit the engine settings. Only the fields sent change; risk, riskGate,\nand strategy replace their whole block. Affected accounts restart on\nthe reconcile this edit triggers.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEngineSettings"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEngineSettings"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEngineSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/settings/overrides": {
      "delete": {
        "tags": [
          "Settings"
        ],
        "summary": "Drop every override, reverting to the configured defaults.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/terminals": {
      "get": {
        "tags": [
          "Terminals"
        ],
        "summary": "List connected MT terminals with health and subscriptions.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/terminals/{terminalId}/ping": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Request an immediate heartbeat from a terminal (liveness probe).",
        "parameters": [
          {
            "name": "terminalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/terminals/{terminalId}/subscribe": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Start streaming ticks (or depth with depth=true, MT5 only) for symbols.",
        "parameters": [
          {
            "name": "terminalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalSubscribeRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalSubscribeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalSubscribeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/terminals/{terminalId}/unsubscribe": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Stop streaming ticks (or depth with depth=true) for symbols.",
        "parameters": [
          {
            "name": "terminalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalSubscribeRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalSubscribeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalSubscribeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/terminals/{terminalId}/positions/{ticket}/close": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Close a single open position by ticket (full close, opposite deal).",
        "parameters": [
          {
            "name": "terminalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "uint64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/terminals/{terminalId}/close-all": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Close every open position on the terminal's account (batch, per-ticket results).",
        "parameters": [
          {
            "name": "terminalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/venues": {
      "get": {
        "tags": [
          "Venues"
        ],
        "summary": "All captured venues (secrets masked) with their runner state.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/venues/alpaca": {
      "post": {
        "tags": [
          "Venues"
        ],
        "summary": "Capture an Alpaca account (API key id + secret; isLive=false for paper).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAlpacaVenueRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAlpacaVenueRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAlpacaVenueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/venues/ctrader/{id}": {
      "put": {
        "tags": [
          "Venues"
        ],
        "summary": "Update a cTrader venue (rotate the token, flip live/demo, enable/disable).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCTraderVenueRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCTraderVenueRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCTraderVenueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/venues/alpaca/{id}": {
      "put": {
        "tags": [
          "Venues"
        ],
        "summary": "Update an Alpaca venue (rotate keys, flip live/paper, enable/disable).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAlpacaVenueRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAlpacaVenueRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAlpacaVenueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/venues/{provider}/{id}": {
      "delete": {
        "tags": [
          "Venues"
        ],
        "summary": "Remove a captured venue; its runner stops on the next reconcile.",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/venues/reconcile": {
      "post": {
        "tags": [
          "Venues"
        ],
        "summary": "Force an immediate fleet reconcile against the venue tables.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/venues/ctrader/oauth/start": {
      "get": {
        "tags": [
          "Venues"
        ],
        "summary": "Start the cTrader OAuth flow: redirects the browser to the cTrader\nconsent page. After the user approves, cTrader redirects back to\n.../oauth/callback, which exchanges the code and captures every\naccount the token can trade as a venue.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/venues/ctrader/oauth/callback": {
      "get": {
        "tags": [
          "Venues"
        ],
        "summary": "cTrader OAuth redirect target: validates the CSRF state, exchanges the\nauthorization code for tokens, discovers every trading account the\ntoken covers, and upserts one venue per account (new venues start\nenabled; existing ones get their tokens rotated). Returns a small HTML\npage since the browser lands here directly.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error_description",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAlpacaVenueRequest": {
        "required": [
          "apiKey",
          "apiSecret"
        ],
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string"
          },
          "apiSecret": {
            "type": "string"
          },
          "isLive": {
            "type": "boolean",
            "default": false
          },
          "accountId": {
            "type": [
              "null",
              "string"
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "KillSwitchRequest": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ModifyPositionRequest": {
        "required": [
          "targetLots"
        ],
        "type": "object",
        "properties": {
          "targetLots": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "RiskGateSettings": {
        "type": "object",
        "properties": {
          "maxOrderNotional": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "maxOrdersPerMinute": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "startTripped": {
            "type": "boolean"
          }
        }
      },
      "RiskSettings": {
        "type": "object",
        "properties": {
          "maxPosition": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "maxOrderQty": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "maxOpenOrders": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          }
        }
      },
      "StrategySettings": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "entryThresholdBps": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "orderQty": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "modelPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "signalThresholdBps": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "TerminalSubscribeRequest": {
        "required": [
          "symbols"
        ],
        "type": "object",
        "properties": {
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depth": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "UpdateAlpacaVenueRequest": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "apiSecret": {
            "type": [
              "null",
              "string"
            ]
          },
          "isLive": {
            "type": [
              "null",
              "boolean"
            ]
          },
