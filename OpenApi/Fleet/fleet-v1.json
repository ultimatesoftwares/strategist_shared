{
  "openapi": "3.0.4",
  "info": {
    "title": "Fleet Control Plane",
    "description": "REST API of fleetd: manage MetaTrader terminal instances (provision, start, stop, delete), terminal templates and the VNC remote-desktop display. Terminals connect directly to the configured engine (Fleet:EngineAddress).",
    "version": "v1"
  },
  "paths": {
    "/api/v1/terminals": {
      "get": {
        "tags": [
          "Terminals"
        ],
        "summary": "List all terminals",
        "description": "Managed terminals; each entry merges config and process state.",
        "operationId": "list_terminals",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TerminalView"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Create a terminal",
        "description": "Registers the terminal and (unless provision=false) starts provisioning it in the background by copying the platform template (building the template first if needed), returning 202 Accepted. Poll GET /terminals/{id} until process.state leaves Provisioning. Default launch command is wine <home>/terminal(64).exe /portable. With provision=false the terminal is registration-only and 201 is returned.",
        "operationId": "create_terminal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTerminalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals/{id}": {
      "get": {
        "tags": [
          "Terminals"
        ],
        "summary": "Get one terminal",
        "description": "process.state is Provisioning/ProvisionFailed while the home directory extraction runs or after it failed.",
        "operationId": "get_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Terminals"
        ],
        "summary": "Update a terminal's config",
        "description": "Platform and home directory are immutable; changes apply on next start.",
        "operationId": "update_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTerminalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Terminals"
        ],
        "summary": "Delete a terminal",
        "description": "Removes the config and the provisioned home directory. Refuses while the process runs or provisioning is active unless ?force=true, which stops/cancels first.",
        "operationId": "delete_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "force",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals/{id}/provision": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "(Re-)provision the home directory",
        "description": "Retries provisioning after a ProvisionFailed, or provisions a terminal created with provision=false. Returns 202 Accepted; poll GET /terminals/{id}.",
        "operationId": "provision_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals/{id}/start": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Start the terminal process",
        "operationId": "start_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals/{id}/stop": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Stop the terminal process",
        "description": "SIGTERM, then a process-tree kill after the grace period.",
        "operationId": "stop_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals/{id}/restart": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Restart the terminal process",
        "operationId": "restart_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/templates": {
      "get": {
        "tags": [
          "Templates"
        ],
        "summary": "Terminal template status",
        "description": "One entry per platform: whether a template is built, an active build, and the last build error.",
        "operationId": "list_templates",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TemplateStatus"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/templates/{platform}": {
      "post": {
        "tags": [
          "Templates"
        ],
        "summary": "Build a terminal template",
        "description": "Downloads the official MetaQuotes installer, silent-installs it under a scratch wineprefix, and publishes the tree to DataDir/templates/{platform} with the connector overlay applied. Returns 202; poll GET /templates. Terminal creation also triggers this automatically when no template exists.",
        "operationId": "build_template",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^(mt4|mt5)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TemplateStatus"
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Templates"
        ],
        "summary": "Delete a terminal template",
        "description": "Removes the built template; existing terminals are unaffected. The next build downloads a fresh installer.",
        "operationId": "delete_template",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^(mt4|mt5)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/vnc/status": {
      "get": {
        "tags": [
          "Vnc"
        ],
        "summary": "VNC unit status",
        "description": "systemctl is-active for the VNC unit (default: fleet-vnc) plus the current listen state. State is \"unknown\" when systemctl is unavailable.",
        "operationId": "vnc_status",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VncStatusView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/vnc/{verb}": {
      "post": {
        "tags": [
          "Vnc"
        ],
        "summary": "Start/stop/restart the VNC display",
        "description": "Runs systemctl <verb> on the VNC unit (Fleet:VncUnit, default fleet-vnc: a persistent Xvnc that managed terminals render into via injected DISPLAY) and returns the listen endpoint (display, port, connectable host IPs) plus the credentials: Fleet:VncPassword when set, otherwise a password generated per start/restart and written to the Xvnc auth file (Fleet:VncPasswdFile under DataDir - no privileged helper needed). fleetd's user needs a polkit rule or sudo wrapper (Fleet:SystemctlBinary) for the systemctl call to succeed.",
        "operationId": "vnc_control",
        "parameters": [
          {
            "name": "verb",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^(start|stop|restart)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VncControlView"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTerminalRequest": {
        "required": [
          "id",
          "name",
          "platform",
          "provision",
          "command",
          "args",
          "workingDir",
          "environment",
          "autoStart"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "platform": {
            "type": "string",
            "nullable": true
          },
          "provision": {
            "type": "boolean",
            "nullable": true
          },
          "command": {
            "type": "string",
            "nullable": true
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "workingDir": {
            "type": "string",
            "nullable": true
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "autoStart": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "ListenInfo": {
        "required": [
          "display",
          "port",
          "listening",
          "hostAddresses"
        ],
        "type": "object",
        "properties": {
          "display": {
            "type": "string"
          },
          "port": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "listening": {
            "type": "boolean"
          },
          "hostAddresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ProcessState": {
        "enum": [
          "Provisioning",
          "ProvisionFailed",
          "Stopped",
          "Running",
          "Exited"
        ]
      },
      "ProcessStatus": {
        "required": [
          "state"
        ],
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/ProcessState"
          },
          "pid": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int32",
            "nullable": true
          },
          "startedAtUnixMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int64",
            "nullable": true
          },
          "exitCode": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int32",
            "nullable": true
          },
          "exitedAtUnixMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int64",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "TemplateStatus": {
        "required": [
          "platform",
          "exists",
          "path",
          "building",
          "lastError",
          "installerUrl"
        ],
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "exists": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "nullable": true
          },
          "building": {
            "type": "boolean"
          },
          "lastError": {
            "type": "string",
            "nullable": true
          },
          "installerUrl": {
            "type": "string"
          }
        }
      },
      "TerminalConfig": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "homeDir": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workingDir": {
            "type": "string"
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "autoStart": {
            "type": "boolean"
          }
        }
      },
      "TerminalView": {
        "required": [
          "id",
          "config",
          "process"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "config": {
            "oneOf": [
              {
                "enum": [
                  null
                ],
                "nullable": true
              },
              {
                "$ref": "#/components/schemas/TerminalConfig"
              }
            ]
          },
          "process": {
            "$ref": "#/components/schemas/ProcessStatus"
          }
        }
      },
      "UnitStatus": {
        "required": [
          "unit",
          "state",
          "active"
        ],
        "type": "object",
        "properties": {
          "unit": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "UpdateTerminalRequest": {
        "required": [
          "name",
          "command",
          "args",
          "workingDir",
          "environment",
          "autoStart"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "command": {
            "type": "string",
            "nullable": true
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "workingDir": {
            "type": "string",
            "nullable": true
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "autoStart": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "VncControlView": {
        "required": [
          "ok",
          "detail",
          "listen",
          "credentials"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "listen": {
            "$ref": "#/components/schemas/ListenInfo"
          },
          "credentials": {
            "oneOf": [
              {
                "enum": [
                  null
                ],
                "nullable": true
              },
              {
                "$ref": "#/components/schemas/VncCredentials"
              }
            ]
          }
        }
      },
      "VncCredentials": {
        "required": [
          "password",
          "generated",
          "passwdFile",
          "error"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "nullable": true
          },
          "generated": {
            "type": "boolean"
          },
          "passwdFile": {
            "type": "string"
          },
