{
  "openapi": "3.0.4",
  "info": {
    "title": "Fleet Control Plane",
    "description": "REST API of fleet: manage MetaTrader terminals as Docker containers (create, start, stop, restart, delete, logs) built from the terminals image. Terminals connect directly to the configured engine (Fleet:EngineAddress).",
    "version": "v1"
  },
  "paths": {
    "/api/v1/terminals": {
      "get": {
        "tags": [
          "Terminals"
        ],
        "summary": "List all terminals",
        "description": "Managed terminals; each entry merges the stored config and the live container state.",
        "operationId": "list_terminals",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TerminalView"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Create a terminal",
        "description": "Registers the terminal and creates its Docker container from the terminals image (Fleet:TerminalImage) with the credentials injected as environment. start=true (or autoStart) also starts it. MetaTrader state persists on a named volume, so later container recreations lose nothing.",
        "operationId": "create_terminal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTerminalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals/{id}": {
      "get": {
        "tags": [
          "Terminals"
        ],
        "summary": "Get one terminal",
        "description": "container.state is Missing until the container has been created; container.staleConfig flags a container older than the stored config (restart to apply).",
        "operationId": "get_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Terminals"
        ],
        "summary": "Update a terminal's config",
        "description": "Platform is immutable. An existing container keeps running with its old config (container.staleConfig=true); restart the terminal to recreate it with the new one.",
        "operationId": "update_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTerminalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Terminals"
        ],
        "summary": "Delete a terminal",
        "description": "Removes the config, the container and (unless ?keepData=true) the MetaTrader state volume. Refuses while the container runs unless ?force=true.",
        "operationId": "delete_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "force",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "keepData",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals/{id}/start": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Start the terminal container",
        "description": "Creates the container first when missing or stale (config changed while stopped), then starts it.",
        "operationId": "start_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals/{id}/stop": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Stop the terminal container",
        "description": "docker stop: SIGTERM, then SIGKILL after Fleet:StopGraceSeconds.",
        "operationId": "stop_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals/{id}/restart": {
      "post": {
        "tags": [
          "Terminals"
        ],
        "summary": "Restart the terminal container",
        "description": "Stops the container and recreates it from the current config when it is stale, so this is also how config updates are applied.",
        "operationId": "restart_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals/{id}/logs": {
      "get": {
        "tags": [
          "Terminals"
        ],
        "summary": "Tail the terminal container's logs",
        "description": "Last ?tail= lines (default 200, max 5000) of the container's stdout/stderr: Xvfb/x11vnc/wine startup and the entrypoint's provisioning output.",
        "operationId": "terminal_logs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tail",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalLogsView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/image": {
      "get": {
        "tags": [
          "Image"
        ],
        "summary": "Terminal image status",
        "description": "Whether Fleet:TerminalImage is present on the Docker daemon.",
        "operationId": "image_status",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageStatus"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/image/pull": {
      "post": {
        "tags": [
          "Image"
        ],
        "summary": "Pull the terminal image",
        "description": "Pulls Fleet:TerminalImage from its registry. Running containers keep their image; restart a terminal to recreate it from the new one (its state volume is preserved).",
        "operationId": "pull_image",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageStatus"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContainerStatus": {
        "required": [
          "state"
        ],
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/TerminalState"
          },
          "containerId": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "vncHostPort": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "startedAtUnixMs": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "exitCode": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "exitedAtUnixMs": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "staleConfig": {
            "type": "boolean"
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateTerminalRequest": {
        "required": [
          "id",
          "name",
          "platform",
          "login",
          "password",
          "server",
          "vncHostPort",
          "environment",
          "autoStart",
          "start"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "platform": {
            "type": "string",
            "nullable": true
          },
          "login": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "server": {
            "type": "string",
            "nullable": true
          },
          "vncHostPort": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "autoStart": {
            "type": "boolean",
            "nullable": true
          },
          "start": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "ImageStatus": {
        "required": [
          "name",
          "present",
          "id",
          "createdAtUnixMs"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "nullable": true
          },
          "createdAtUnixMs": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "TerminalLogsView": {
        "required": [
          "stdout",
          "stderr"
        ],
        "type": "object",
        "properties": {
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          }
        }
      },
      "TerminalState": {
        "enum": [
          "Missing",
          "Created",
          "Running",
          "Restarting",
          "Paused",
          "Exited",
          "Dead"
        ]
      },
      "TerminalView": {
        "required": [
          "id",
          "name",
          "platform",
          "login",
          "server",
          "vncHostPort",
          "environment",
          "autoStart",
          "container"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "login": {
            "type": "string"
          },
          "server": {
            "type": "string"
          },
          "vncHostPort": {
            "type": "integer",
            "format": "int32"
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "autoStart": {
            "type": "boolean"
          },
          "container": {
            "$ref": "#/components/schemas/ContainerStatus"
          }
        }
      },
      "UpdateTerminalRequest": {
        "required": [
          "name",
          "login",
          "password",
          "server",
          "vncHostPort",
          "environment",
          "autoStart"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "login": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "server": {
            "type": "string",
            "nullable": true
          },
          "vncHostPort": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "autoStart": {
            "type": "boolean",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "AccessToken": {
        "type": "http",
        "description": "Fleet access token issued by the Strategist server (POST /api/v1/fleet/token there; short-lived ES256 JWT with audience \"fleetd\" - on 401, fetch a fresh one and retry).",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "AccessToken": [ ]
    }
  ],
  "tags": [
    {
      "name": "Image"
    },
    {
      "name": "Terminals"
    }
  ]
}