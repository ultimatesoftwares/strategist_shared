<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Grpc.AspNetCore service bases need the ASP.NET Core shared framework
       even from a class library. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The backtest API's push-feed contract (backtestevents.BacktestFeed):
       subject + JSON + timestamp, replay-latest-then-live. The bot's feeds
       moved to FIX (shared/FleetBridge/spec/FIX44-FLEET.xml); only the EventBroker hub is
       shared between both hosts. -->
  <ItemGroup>
    <Protobuf Include="..\Protos\backtest\v1\backtest_events.proto" ProtoRoot="..\Protos" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
  </ItemGroup>

</Project>
